{
  "name": "l-note",
  "version": "0.20.44",
  "private": true,
  "description": "Inkpad(L.Note) 前端构建管线：Vite dev server + 产物打包（src-app 拼接由 tools/build-app.js 负责）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:vendor": "node tools/build-vendor.js",
    "build:app": "node tools/build-app.js",
    "verify:app": "node tools/build-app.js --verify",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "vite": "^5.4.0",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "codemirror": "^5.65.21",
    "diff": "^5.2.2",
    "highlight.js": "^11.11.2",
    "katex": "^0.16.47",
    "marked": "^12.0.2",
    "mermaid": "^10.9.8"
  }
}
